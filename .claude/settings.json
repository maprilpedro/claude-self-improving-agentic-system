{
  "enabledPlugins": {
    "obsidian-cli@obsidian-cli-skill": true
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_search_users",
      "Bash(obsidian read *)",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_read_thread",
      "Bash(rtk git log *)",
      "Bash(rtk git status *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git show *)",
      "Bash(rtk grep *)",
      "Bash(rtk proxy grep *)",
      "Bash(obsidian files *)",
      "Bash(obsidian vault *)",
      "Bash(obsidian folders *)",
      "Bash(obsidian backlinks *)",
      "Bash(obsidian wordcount *)",
      "Bash(obsidian daily:path *)",
      "Bash(obsidian daily:read)",
      "Bash(obsidian daily:read *)",
      "Bash(obsidian history:read *)",
      "Bash(rtk proxy ls *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/archive_memory.py\" --check-startup \"$CLAUDE_PROJECT_DIR\" || true",
            "statusMessage": "Checking session-start memory files against the read cap..."
          }
        ]
      }
    ]
  }
}
