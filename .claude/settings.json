{
  "enabledPlugins": {
    "obsidian-cli@obsidian-cli-skill": true
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_search_users",
      "Bash(obsidian read *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/archive_memory.py\" --check-startup \"$CLAUDE_PROJECT_DIR\" || true",
            "statusMessage": "Checking session-start memory files against the read cap..."
          }
        ]
      }
    ]
  }
}
